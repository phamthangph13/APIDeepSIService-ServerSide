# ─────────────────────────────────────────────────────────────
# DeepSI Agent API — environment template
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# App
APP_ENV=development
APP_NAME=DeepSI Agent
APP_VERSION=1.0.0
PORT=8080
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080
APP_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=info

# HTTP
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=120s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=10485760

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=deepsi_agent
MONGO_CONNECT_TIMEOUT=10s

# Auth / sessions
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=deepsi-agent
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
RESET_PASSWORD_TTL=30m
VERIFY_EMAIL_TTL=24h
OAUTH_CODE_TTL=5m
BCRYPT_COST=12
REQUIRE_EMAIL_VERIFICATION=false
AUTH_EXPOSE_DEBUG_TOKENS=false
AUTH_RATE_LIMIT_PER_MINUTE=30
# Generate with: openssl rand -base64 48
API_KEY_PEPPER=replace-with-a-separate-random-pepper
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# SMTP (leave SMTP_HOST empty to log emails to stdout in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@deepsi.space
SMTP_FROM_NAME=DeepSI Agent
SMTP_TLS_MODE=starttls

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave empty to derive from PUBLIC_API_URL
GOOGLE_REDIRECT_URL=
GOOGLE_SCOPES=openid,email,profile

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Leave empty to derive from PUBLIC_API_URL
GITHUB_REDIRECT_URL=
GITHUB_SCOPES=read:user,user:email

# SePay webhook
# api_key: Authorization: Apikey <key>
# hmac:    X-SePay-Signature: sha256=<hex>, X-SePay-Timestamp: <unix>
# none:    development only
SEPAY_WEBHOOK_AUTH_MODE=api_key
SEPAY_WEBHOOK_API_KEY=
SEPAY_WEBHOOK_SECRET=

# SePay Payment Gateway (checkout)
SEPAY_MERCHANT_ID=
SEPAY_CHECKOUT_SECRET=
SEPAY_CHECKOUT_URL=https://pay.sepay.vn/v1/checkout/init
SEPAY_PAYMENT_METHOD=
SEPAY_SUCCESS_URL=http://localhost:5173/dashboard/billing?status=success
SEPAY_ERROR_URL=http://localhost:5173/dashboard/billing?status=error
SEPAY_CANCEL_URL=http://localhost:5173/dashboard/billing?status=cancel

# Bank-transfer fallback (also used for the QR code)
SEPAY_BANK_CODE=
SEPAY_BANK_NAME=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_HOLDER=
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img

# Set true only for local development. Enables POST /billing/orders/:id/mock-complete.
PAYMENT_MOCK_ENABLED=true
PAYMENT_ORDER_TTL=24h

# Upstream LLM (OpenAI-compatible). LLM_BASE_URL should include /v1 when the
# provider expects it, e.g. https://api.openai.com/v1
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT=120s
LLM_MODELS=deepsi-s1,deepsi-m1,deepsi-v1,deepsi-e1

# CORS — comma-separated exact origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Seed admin account. Leave ADMIN_PASSWORD empty to disable seeding.
ADMIN_EMAIL=admin@deepsi.space
ADMIN_PASSWORD=
ADMIN_NAME=DeepSI Admin

# Plan overrides. Defaults mirror the marketing site. The API serves these
# values from GET /plans, and the frontend renders them directly. Set
# KEY_LIMIT=0 for unlimited keys. QUOTA_LABEL and FEATURES are optional;
# FEATURES is comma-separated. When token limits change, QUOTA_LABEL is
# regenerated automatically unless it is set explicitly.
# PLAN_FREE_NAME=Free
# PLAN_FREE_PRICE_VND=0
# PLAN_FREE_PRICE_LABEL=0đ
# PLAN_FREE_CADENCE=mãi mãi
# PLAN_FREE_MONTHLY_TOKENS=300000
# PLAN_FREE_DAILY_TOKENS=10000
# PLAN_FREE_KEY_LIMIT=5
# PLAN_FREE_RETENTION_DAYS=7
# PLAN_FREE_QUOTA_LABEL=10.000 token/ngày
# PLAN_FREE_FEATURES=10.000 token mỗi ngày,5 API key miễn phí,Tương thích OpenAI SDK
# PLAN_PLUS_NAME=Plus
# PLAN_PLUS_PRICE_VND=1499000
# PLAN_PLUS_PRICE_LABEL=1.499.000đ
# PLAN_PLUS_CADENCE=/ tháng
# PLAN_PLUS_MONTHLY_TOKENS=2000000
# PLAN_PLUS_DAILY_TOKENS=70000
# PLAN_PLUS_KEY_LIMIT=20
# PLAN_PLUS_RETENTION_DAYS=30
# PLAN_PLUS_QUOTA_LABEL=2.000.000 token/tháng
# PLAN_PLUS_FEATURES=2.000.000 token mỗi tháng,20 API key miễn phí,Tất cả mô hình
# PLAN_ULTRAL_NAME=Ultral
# PLAN_ULTRAL_PRICE_VND=2499000
# PLAN_ULTRAL_PRICE_LABEL=2.499.000đ
# PLAN_ULTRAL_CADENCE=/ tháng
# PLAN_ULTRAL_MONTHLY_TOKENS=5000000
# PLAN_ULTRAL_DAILY_TOKENS=180000
# PLAN_ULTRAL_KEY_LIMIT=0
# PLAN_ULTRAL_RETENTION_DAYS=90
# PLAN_ULTRAL_QUOTA_LABEL=5.000.000 token/tháng
# PLAN_ULTRAL_FEATURES=5.000.000 token mỗi tháng,API key không giới hạn,SLA 99,9%
